    constraint threshold_seal_066_bound == true;
    constraint chain_id == 1202;
  }

  outcome assert_threshold_seal_067(payload: Bytes) {
    require payload != @0;
    constraint threshold_seal_067_bound == true;
    constraint chain_id == 1202;
  }

  outcome assert_threshold_seal_068(payload: Bytes) {
    require payload != @0;
    constraint threshold_seal_068_bound == true;
    constraint chain_id == 1202;
  }

