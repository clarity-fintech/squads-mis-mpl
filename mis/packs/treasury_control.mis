  invariant letter_hash_bound: letter_hash_root != @0;
  invariant embed_gates_present: embed_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_treasury_control_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant treasury_control_021: treasury_control_021_bound == true;
  invariant treasury_control_022: treasury_control_022_bound == true;
  invariant treasury_control_023: treasury_control_023_bound == true;
  invariant treasury_control_024: treasury_control_024_bound == true;
  invariant treasury_control_025: treasury_control_025_bound == true;
